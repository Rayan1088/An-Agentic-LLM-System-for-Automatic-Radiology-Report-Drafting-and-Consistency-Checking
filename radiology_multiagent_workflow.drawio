                <mxCell id="4" value="&lt;h1 style=&quot;text-align: center;&quot;&gt;&lt;span role=&quot;text&quot;&gt;&lt;span style=&quot;&quot; data-end=&quot;60&quot; data-start=&quot;49&quot;&gt;&lt;font style=&quot;color: rgb(153, 0, 0);&quot;&gt;Key Point For Choice LLMs [1.Report Drafting] [2.Reasoning] [3.Long Term Context]&lt;/font&gt;&lt;/span&gt;&lt;/span&gt;&lt;/h1&gt;&lt;h2 style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;strong style=&quot;color: rgb(63, 63, 63); text-align: center; background-color: transparent;&quot; data-end=&quot;60&quot; data-start=&quot;49&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;1.&amp;nbsp;&lt;/strong&gt;&lt;strong style=&quot;background-color: transparent; text-align: center; color: rgb(63, 63, 63);&quot; data-end=&quot;60&quot; data-start=&quot;49&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;a href=&quot;https://openai.com/index/introducing-gpt-5-5/?utm_source=chatgpt.com&quot;&gt;GPT-5.5(OpenAI)&lt;/a&gt;,&amp;nbsp;&lt;/font&gt;&lt;/strong&gt;&lt;/font&gt;&lt;/h2&gt;&lt;h2 style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63); text-align: center; background-color: transparent; font-weight: normal;&quot; role=&quot;text&quot;&gt;&lt;strong style=&quot;&quot; data-end=&quot;60&quot; data-start=&quot;49&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;2.&amp;nbsp;&lt;a style=&quot;&quot; href=&quot;https://www.anthropic.com/claude/opus?cid=13079&amp;amp;utm_source=chatgpt.com&quot;&gt;&lt;font style=&quot;&quot;&gt;Fable-5(Claude AI)&lt;/font&gt;&lt;/a&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); text-align: center; background-color: transparent; font-weight: normal;&quot; role=&quot;text&quot;&gt;&lt;strong style=&quot;&quot; data-end=&quot;60&quot; data-start=&quot;49&quot;&gt;&lt;font style=&quot;&quot;&gt;,&lt;/font&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/font&gt;&lt;/h2&gt;&lt;h2 style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-weight: normal; color: rgb(63, 63, 63);&quot; role=&quot;text&quot;&gt;&lt;strong style=&quot;&quot; data-end=&quot;60&quot; data-start=&quot;49&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;3. &lt;a href=&quot;https://deepmind.google/models/gemini/&quot;&gt;Gemini 3.1 Pro,&lt;/a&gt;&lt;/font&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/h2&gt;&lt;h2 style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-weight: normal; color: rgb(63, 63, 63);&quot; role=&quot;text&quot;&gt;&lt;strong style=&quot;&quot; data-end=&quot;60&quot; data-start=&quot;49&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;4.&lt;/font&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt; &lt;/span&gt;&lt;font&gt;&lt;a href=&quot;https://ai.meta.com/blog/llama-4-multimodal-intelligence/?_bhlid=db5eac5620dec973e527e6d1bd9af3bb01071404&amp;amp;utm_source=chatgpt.com&quot;&gt;Llana 4 Maverick(Facebook) use&amp;nbsp;&lt;/a&gt;&lt;/font&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-family: &amp;quot;Optimistic Text Normal&amp;quot;, Helvetica, Arial, sans-serif; color: rgb(63, 63, 63);&quot;&gt;&lt;font style=&quot;color: rgb(153, 0, 0);&quot;&gt;&lt;a href=&quot;https://ai.meta.com/blog/llama-4-multimodal-intelligence/?_bhlid=db5eac5620dec973e527e6d1bd9af3bb01071404&amp;amp;utm_source=chatgpt.com&quot;&gt;mixture-of-experts (MoE)&lt;/a&gt;&lt;/font&gt;&lt;/span&gt;&lt;/h2&gt;" style="whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
