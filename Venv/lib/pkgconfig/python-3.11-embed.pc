prefix=/Users/rayan/Desktop/Projects/An-Agentic-LLM-System-for-Automatic-Radiology-Report-Drafting-and-Consistency-Checking/Venv
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: Python
Description: Embed Python into an application
